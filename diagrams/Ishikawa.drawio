  <diagram id="ishikawa-iro" name="Ishikawa">
    <mxGraphModel dx="1280" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="effect" value="&lt;b&gt;EFFECT&lt;/b&gt;&lt;br&gt;Fragmented, delayed, and unsafe reporting; low trust and weak follow-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#153b35;strokeColor=#153b35;fontColor=#ffffff;fontSize=17;align=center;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="930" y="278" width="270" height="164" as="geometry"/></mxCell>
        <mxCell id="people" value="&lt;b&gt;PEOPLE&lt;/b&gt;&lt;br&gt;• Low awareness of the right contact&lt;br&gt;• Fear of blame or retaliation&lt;br&gt;• Unclear ownership between groups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4e7;strokeColor=#9bb78b;fontColor=#243b31;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="220" y="75" width="220" height="98" as="geometry"/></mxCell>
        <mxCell id="process" value="&lt;b&gt;PROCESS&lt;/b&gt;&lt;br&gt;• Reports arrive through separate channels&lt;br&gt;• No standard reference or route&lt;br&gt;• Follow-up steps may be inconsistent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4e7;strokeColor=#9bb78b;fontColor=#243b31;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="75" width="220" height="98" as="geometry"/></mxCell>
        <mxCell id="technology" value="&lt;b&gt;TECHNOLOGY&lt;/b&gt;&lt;br&gt;• Uneven device/data access&lt;br&gt;• Inaccessible or difficult channels&lt;br&gt;• Separate tools do not share status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4e7;strokeColor=#9bb78b;fontColor=#243b31;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="740" y="75" width="220" height="98" as="geometry"/></mxCell>
        <mxCell id="governance" value="&lt;b&gt;GOVERNANCE &amp;amp; TRUST&lt;/b&gt;&lt;br&gt;• Privacy and retention rules unclear&lt;br&gt;• No visible response owner&lt;br&gt;• Public/private detail boundary unclear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4e7;strokeColor=#9bb78b;fontColor=#243b31;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="220" y="536" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="communication" value="&lt;b&gt;COMMUNICATION&lt;/b&gt;&lt;br&gt;• Reporter may receive no feedback&lt;br&gt;• Updates spread across different groups&lt;br&gt;• Received/assigned/resolved status unclear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4e7;strokeColor=#9bb78b;fontColor=#243b31;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="480" y="536" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="resources" value="&lt;b&gt;RESOURCES &amp;amp; ENVIRONMENT&lt;/b&gt;&lt;br&gt;• Response staff or funds may be limited&lt;br&gt;• Weather, roads, and distance affect work&lt;br&gt;• Issue volume may exceed capacity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4e7;strokeColor=#9bb78b;fontColor=#243b31;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="740" y="536" width="220" height="105" as="geometry"/></mxCell>
